<?xml version="1.0" encoding="utf-8"?>
<!-- IIS already hides App_Data; keep an explicit deny for defense in depth. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
